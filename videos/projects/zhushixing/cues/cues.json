 ],
 "cues": [
  {
   "s": 0.0,
   "e": 1.4,
   "t": "一说起西行取经"
  },
  {
   "s": 1.78,
   "e": 3.46,
   "t": "你脑子里第一个冒出来的"
  },
  {
   "s": 3.68,
   "e": 4.66,
   "t": "肯定是玄奘"
  },
  {
   "s": 4.66,
   "e": 6.5,
   "t": "西游记演了几十年"
  },
  {
   "s": 6.82,
   "e": 8.8,
   "t": "唐僧师徒九九八十一难"
  },
  {
   "s": 9.2,
   "e": 11.4,
   "t": "几乎成了取经两个字的代名词"
  },
  {
   "s": 11.4,
   "e": 14.22,
   "t": "但我要告诉你一件你可能不知道的事"
  },
  {
   "s": 14.22,
   "e": 16.9,
   "t": "第一个西行求法的中国和尚"
  },
  {
   "s": 17.16,
   "e": 19.32,
   "t": "比玄奘早了整整三百多年"
  },
  {
   "s": 19.32,
   "e": 20.8,
   "t": "而且他这一辈子"
  },
  {
   "s": 21.08,
   "e": 22.26,
   "t": "连印度都没走到"
  },
  {
   "s": 22.26,
   "e": 23.94,
   "t": "这个人叫朱士行"
  },
  {
   "s": 24.28,
   "e": 25.18,
   "t": "三国时候的人"
  },
  {
   "s": 25.48,
   "e": 31.56,
   "t": "他还有另一个第一中国历史上第一个依照规矩正式受戒出家的汉族和尚"
  },
  {
   "s": 31.56,
   "e": 32.46,
   "t": "在那以前"
  },
  {
   "s": 32.46,
   "e": 33.52,
   "t": "汉人出家"
  },
  {
   "s": 33.68,
   "e": 35.72,
   "t": "就是剃个头披件袈裟"
  },
  {
   "s": 35.98,
   "e": 37.66,
   "t": "没有完整的受戒仪式"
  },
  {
   "s": 38.0,
   "e": 39.46,
   "t": "算不上真正的比丘"
  },
  {
   "s": 39.46,
   "e": 41.24,
   "t": "朱士行出家之后"
  },
  {
   "s": 41.38,
   "e": 42.76,
   "t": "在洛阳讲一部经"
  },
  {
   "s": 43.1,
   "e": 44.16,
   "t": "叫道行般若"
  },
  {
   "s": 44.42,
   "e": 45.12,
   "t": "讲着讲着"
  },
  {
   "s": 45.3,
   "e": 46.02,
   "t": "他卡住了"
  },
  {
   "s": 46.02,
   "e": 46.88,
   "t": "这部经"
  },
  {
   "s": 46.88,
   "e": 49.06,
   "t": "是佛法刚传来时翻译的"
  },
  {
   "s": 49.4,
   "e": 50.76,
   "t": "译人对中文生疏"
  },
  {
   "s": 50.76,
   "e": 53.42,
   "t": "翻得又硬又涩更要命的是"
  },
  {
   "s": 53.76,
   "e": 56.18,
   "t": "许多地方前后不接道理不通"
  },
  {
   "s": 56.18,
   "e": 58.92,
   "t": "是当年的译者把原典删节了"
  },
  {
   "s": 59.14,
   "e": 62.12,
   "t": "还是他手里这本本来就是个简略抄本"
  },
  {
   "s": 62.12,
   "e": 63.56,
   "t": "朱士行说不准"
  },
  {
   "s": 63.74,
   "e": 65.08,
   "t": "当时大家都在传"
  },
  {
   "s": 65.52,
   "e": 66.1,
   "t": "西域那边"
  },
  {
   "s": 66.1,
   "e": 68.24,
   "t": "应该有一部更完整的全本"
  },
  {
   "s": 68.24,
   "e": 69.64,
   "t": "公元二六年"
  },
  {
   "s": 69.94,
   "e": 71.26,
   "t": "朱士行做了个决定"
  },
  {
   "s": 71.56,
   "e": 72.28,
   "t": "自己去找"
  },
  {
   "s": 72.58,
   "e": 73.64,
   "t": "他从洛阳出发"
  },
  {
   "s": 73.88,
   "e": 74.54,
   "t": "过关中"
  },
  {
   "s": 74.82,
   "e": 75.38,
   "t": "走河西"
  },
  {
   "s": 75.74,
   "e": 76.22,
   "t": "出阳关"
  },
  {
   "s": 76.62,
   "e": 78.86,
   "t": "沿着大沙漠的边缘一路向西"
  },
  {
   "s": 78.86,
   "e": 80.28,
   "t": "没有徒弟四人"
  },
  {
   "s": 80.54,
   "e": 81.32,
   "t": "没有白龙马"
  },
  {
